# HealthOS API environment template. Copy to src/.env and replace placeholders.
ENVIRONMENT=production

APP_NAME=HealthOS API
APP_DESCRIPTION=HealthOS outpatient operations API
APP_VERSION=1.0.0
LICENSE_NAME=Proprietary
CONTACT_NAME=HealthOS
CONTACT_EMAIL=engineering@example.com

HEALTHOS_DATABASE_NAME=healthos
HEALTHOS_ARCHITECTURE_VERSION=1.0
HEALTHOS_ARCHITECTURE_STAGE=mvp
HEALTHOS_CORE_SCHEMAS='["identity","organization","platform","care","financial","governance"]'
HEALTHOS_FUTURE_SCHEMAS='["operations","analytics","ai"]'
HEALTHOS_AUTH_PROVIDER=logto
HEALTHOS_FEATURE_RESOLUTION_ORDER='["platform","organization"]'
HEALTHOS_WORKFLOW_RESOLUTION_ORDER='["platform","organization"]'

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_SYNC_URL=postgresql://USER:PASSWORD@HOST:5432/healthos
POSTGRES_ASYNC_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/healthos

# Shared cross-worker SSE invalidation transport
REDIS_QUEUE_HOST=redis
REDIS_QUEUE_PORT=6379

# Required by the current settings loader; legacy local-admin values are not used by Logto.
ADMIN_NAME=disabled
ADMIN_EMAIL=disabled@example.com
ADMIN_USERNAME=disabled
ADMIN_PASSWORD=replace-with-random-placeholder

CLIENT_CACHE_MAX_AGE=60

# Logto BFF authentication
LOGTO_ENABLED=true
LOGTO_ENDPOINT=https://identity.example.com
LOGTO_APP_ID=replace-with-logto-app-id
LOGTO_APP_SECRET=replace-with-logto-app-secret
LOGTO_REDIRECT_URI=https://api.example.com/api/v1/auth/callback
LOGTO_POST_LOGOUT_REDIRECT_URI=https://app.example.com/login
LOGTO_SCOPES='["openid"]'
LOGTO_ORGANIZATIONS_ENABLED=false

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
AUTH_LOCAL_DEV_BYPASS=false
AUTH_POST_LOGIN_REDIRECT_URI=https://app.example.com/facility-selection
AUTH_POST_REGISTRATION_REDIRECT_URI=https://app.example.com/design-preview/stitch/registration/clinic

# CRUD admin is disabled; keep this only if the settings loader requires the group.
CRUD_ADMIN_ENABLED=false
CRUD_ADMIN_MOUNT_PATH=/admin
CRUD_ADMIN_ALLOWED_IPS_LIST='[]'
CRUD_ADMIN_ALLOWED_NETWORKS_LIST='[]'
CRUD_ADMIN_MAX_SESSIONS=5
CRUD_ADMIN_SESSION_TIMEOUT=3600
SESSION_SECURE_COOKIES=true
CRUD_ADMIN_TRACK_EVENTS=false
CRUD_ADMIN_TRACK_SESSIONS=false

# Console logging
CONSOLE_LOG_LEVEL=INFO
CONSOLE_LOG_FORMAT_JSON=true
CONSOLE_LOG_INCLUDE_REQUEST_ID=true
CONSOLE_LOG_INCLUDE_PATH=true
CONSOLE_LOG_INCLUDE_METHOD=true
CONSOLE_LOG_INCLUDE_CLIENT_HOST=false
CONSOLE_LOG_INCLUDE_STATUS_CODE=true

# File logging
FILE_LOG_MAX_BYTES=10485760
FILE_LOG_BACKUP_COUNT=5
FILE_LOG_FORMAT_JSON=true
FILE_LOG_LEVEL=INFO
FILE_LOG_INCLUDE_REQUEST_ID=true
FILE_LOG_INCLUDE_PATH=true
FILE_LOG_INCLUDE_METHOD=true
FILE_LOG_INCLUDE_CLIENT_HOST=false
FILE_LOG_INCLUDE_STATUS_CODE=true

# JSON array or comma-separated list. Origins must have no trailing slash.
# The patient app is served on localhost:5174 / 127.0.0.1:5174 and is included
# in the code defaults; if this variable is set explicitly it must include them.
CORS_ORIGINS='["https://healthos.medikai.in","http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]'
CORS_METHODS='["GET","POST","PUT","PATCH","DELETE","OPTIONS"]'
CORS_HEADERS='["Content-Type","Idempotency-Key","X-CSRF-Token","X-Client-Timezone","X-Client-Date","X-Client-Timestamp"]'

# Patient portal (PA-BE01). Separate from the staff AUTH_* cookie settings.
# The patient cookie is opaque and server-side; only its SHA-256 digest is stored.
# PATH scopes the cookie to the patient API namespace. Production cross-site
# deployments (separate frontend/API hosts) require SameSite=none + Secure.
PATIENT_SESSION_COOKIE_NAME=healthos_patient_session
PATIENT_SESSION_TTL_SECONDS=2592000
PATIENT_COOKIE_SECURE=true
PATIENT_COOKIE_SAMESITE=none
PATIENT_COOKIE_PATH=/api/v1/patient
PATIENT_CSRF_HEADER_NAME=X-CSRF-Token

# Phone OTP policy (expiry/attempts/cooldown/rate limits).
PATIENT_OTP_CODE_TTL_SECONDS=600
PATIENT_OTP_RESEND_COOLDOWN_SECONDS=60
PATIENT_OTP_MAX_ATTEMPTS=5
PATIENT_OTP_PHONE_LIMIT=5
PATIENT_OTP_IP_LIMIT=20
PATIENT_OTP_THROTTLE_WINDOW_SECONDS=3600
PATIENT_OTP_CODE_LENGTH=6
# PATIENT_OTP_PEPPER=<long-random-pepper>   # falls back to SECRET_KEY

# OTP delivery provider. `dev` is an allowlisted synthetic provider that never
# sends real SMS and is inert in production. `unconfigured` performs no delivery
# (requests fail closed with 503). Do not claim live delivery until a real
# vendor adapter exists.
PATIENT_OTP_PROVIDER=unconfigured
# Comma-separated synthetic phones allowed by the dev provider.
PATIENT_OTP_DEV_ALLOWLIST='["+919999900001"]'
# Local-only: echo the generated code for allowlisted phones. Never enable
# outside local development (TestClient/dev machines only).
PATIENT_OTP_DEV_EXPOSE_CODE=false

# Staff-created portal link invitations.
PATIENT_LINK_INVITATION_TTL_HOURS=168
PATIENT_LINK_INVITATION_MAX_TTL_HOURS=720

# Private patient-document storage (optional globally; required by document routes)
GCS_BUCKET_NAME=<YOUR_PRIVATE_GCS_BUCKET>
GCS_SIGNING_SERVICE_ACCOUNT=<SIGNING_SERVICE_ACCOUNT_EMAIL>

# Push (FCM / Firebase Admin) — backend-only server credentials.
# Public Firebase web config and the public VAPID key belong to the frontend
# (VITE_*), never here. Do not commit service-account JSON or private keys.
FCM_ENABLED=true
FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
# Preferred: absolute path to the service-account JSON (server-only file).
FIREBASE_SERVICE_ACCOUNT_FILE=<ABSOLUTE_PATH_TO_SERVICE_ACCOUNT_JSON>
# Alternative inline service-account JSON (secret); prefer the file path.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}
FCM_DEFAULT_TTL_SECONDS=3600

# Ably realtime (staff + patient portals) — backend-only server key.
# ABLY_API_KEY is never returned to a browser and must not be committed or
# exposed as a VITE_* variable. Clients receive only signed, subscribe-only
# TokenRequests from /api/v1/communication/realtime/token (staff) and
# /api/v1/patient/realtime/token (patient cookie + CSRF).
ABLY_API_KEY=<ABLY_API_KEY>
ABLY_CHANNEL_NAMESPACE=dev
ABLY_TOKEN_TTL_SECONDS=1800
ABLY_TOKEN_RENEW_AFTER_SECONDS=900
# Presence is a staff-side facility feature; patient channels are subscribe-only.
ABLY_PRESENCE_ENABLED=true
