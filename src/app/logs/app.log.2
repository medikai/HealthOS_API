f_member.id, organization.staff_member.organization_id, organization.staff_member.user_account_id, organization.staff_member.is_active, organization.staff_member.created_at, organization.organization.id AS id_1, organization.organization.name, organization.organization.code, organization.organization.logto_organization_id, organization.organization.is_active AS is_active_1, organization.organization.created_at AS created_at_1, organization.organization.updated_at, identity.practitioner.id AS id_2, identity.practitioner.organization_id AS organization_id_1, identity.practitioner.person_name, identity.practitioner.specialty, identity.practitioner.specialty_id, identity.practitioner.sub_specialty_id, identity.practitioner.designation_id, identity.practitioner.medical_council_reg_no, identity.practitioner.prescription_authority_status, identity.practitioner.has_prescription_authority, identity.practitioner.user_account_id AS user_account_id_1, identity.practitioner.is_active AS is_active_2, identity.practitioner.created_at AS created_at_2, organization.staff_assignment.role_code \nFROM organization.staff_member JOIN organization.organization ON organization.organization.id = organization.staff_member.organization_id LEFT OUTER JOIN organization.staff_assignment ON organization.staff_assignment.staff_member_id = organization.staff_member.id AND organization.staff_assignment.is_active IS true LEFT OUTER JOIN identity.practitioner ON identity.practitioner.user_account_id = organization.staff_member.user_account_id AND identity.practitioner.organization_id = organization.staff_member.organization_id AND identity.practitioner.is_active IS true \nWHERE organization.staff_member.user_account_id = $1::UUID AND organization.staff_member.is_active IS true AND organization.organization.is_active IS true]\n[parameters: (UUID('01a0a021-ff4b-785d-95d8-d08e7460943a'),)]\n(Background on this error at: https://sqlalche.me/e/20/f405)"}
